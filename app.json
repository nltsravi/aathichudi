{
  "expo": {
    "name": "Aathichudi",
    "displayName": "ஆத்திச்சூடி",
    "slug": "aathichudi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/icon.png",
    "scheme": "aathichudi",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FDFBF7"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nts.aathichudi",
      "infoPlist": {
        "NSPhotoLibraryAddUsageDescription": "Aathichudi needs permission to save Tamil verse cards to your photo library."
      }
    },
    "android": {
      "package": "com.nts.aathichudi",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/adaptive-icon.png",
        "backgroundColor": "#4A0E17"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/icons/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FDFBF7",
          "image": "./assets/splash/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icons/notification-icon.png",
          "color": "#7A1C28"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "44871328-cfbe-409d-a366-f1a939597bde"
      }
    }
  }
}
