{
  "name": "aathichudi",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:android": "node scripts/build-android.js --apk",
    "build:android:apk": "node scripts/build-android.js --apk",
    "build:android:bundle": "node scripts/build-android.js --bundle",
    "build:android:aab": "node scripts/build-android.js --bundle",
    "build:android:debug": "node scripts/build-android.js --debug",
    "build:android:clean": "node scripts/build-android.js --clean",
    "build:android:eas": "npx --yes eas-cli build --platform android --profile production",
    "build:android:eas:apk": "npx --yes eas-cli build --platform android --profile preview",
    "build:ios:eas": "npx --yes eas-cli build --platform ios --profile production",
    "eas": "npx --yes eas-cli",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "validate-data": "node scripts/validate-data.js",
    "postinstall": "node scripts/patch-expo-notifications.js"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "expo": "~58.0.14",
    "expo-clipboard": "~58.0.3",
    "expo-constants": "~58.0.12",
    "expo-file-system": "~58.0.9",
    "expo-font": "~58.0.8",
    "expo-haptics": "~58.0.7",
    "expo-localization": "~58.0.4",
    "expo-notifications": "~58.1.5",
    "expo-print": "~58.0.6",
    "expo-router": "~58.0.23",
    "expo-sharing": "~58.0.19",
    "expo-splash-screen": "~58.0.10",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-view-shot": "^6.1.1",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.3.0",
    "jest": "^29.7.0",
    "jest-expo": "~58.0.11",
    "typescript": "~6.0.3"
  },
  "private": true
}
